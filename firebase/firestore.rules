rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isMember(businessId){return signedIn() && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));}
  match /users/{uid}{allow read: if signedIn() && request.auth.uid == uid; allow write: if false;}
  match /businesses/{businessId}{allow read: if isMember(businessId); allow write: if false; match /members/{uid}{allow read: if signedIn() && request.auth.uid == uid; allow write: if false;} match /{document=**}{allow read: if isMember(businessId); allow write: if false;}}
  match /{document=**}{allow read,write: if false;}
 }
}
